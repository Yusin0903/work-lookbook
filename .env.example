DATABASE_URL="postgresql://lookbook:lookbook@localhost:55432/lookbook?schema=public"

# Cloudflare R2 (S3-compatible object storage) — see README "Setting up Cloudflare R2"
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""
R2_PUBLIC_URL=""
# Optional: reject uploads once total stored media would exceed this many bytes.
# Defaults to 9GiB (just under R2's 10GB free tier) if unset.
R2_STORAGE_LIMIT_BYTES=""

# Admin login
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="change-me"
SESSION_SECRET="change-this-to-a-long-random-string-at-least-32-chars"
